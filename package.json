{
  "name": "opencode-sidebar-tui",
  "displayName": "ULW Sidebar Terminal",
  "description": "A fast native shell terminal in the VS Code secondary sidebar.",
  "version": "1.12.16",
  "publisher": "islee23520",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.106.0",
    "node": ">=20.0.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "terminal",
    "sidebar",
    "shell"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/islee23520/ulwcode.git"
  },
  "license": "MIT",
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ulwHerdr",
          "title": "Herdr",
          "icon": "resources/ulwcode-sidebar.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "ulwContainer",
          "title": "ULW",
          "icon": "resources/ulwcode-sidebar.svg",
          "when": "config.ulw.sidebar.enabled"
        }
      ]
    },
    "views": {
      "ulwContainer": [
        {
          "id": "ulw",
          "name": "Terminal",
          "type": "webview",
          "icon": "resources/ulwcode-sidebar.svg",
          "when": "config.ulw.sidebar.enabled"
        }
      ],
      "ulwHerdr": [
        {
          "id": "ulw.herdr.spaces",
          "name": "Spaces",
          "when": "config.ulw.herdr.enabled"
        },
        {
          "id": "ulw.herdr.agents",
          "name": "Agents",
          "when": "config.ulw.herdr.enabled"
        }
      ]
    },
    "commands": [
      {
        "command": "ulw.toggleEditorLocation",
        "title": "ULW: Toggle Terminal Location",
        "category": "ULW",
        "icon": "$(layout-sidebar-right)",
        "shortTitle": "Toggle Location"
      },
      {
        "command": "ulw.sendSelectionToTerminal",
        "title": "ULW: Send Selection to Terminal",
        "category": "ULW"
      },
      {
        "command": "ulw.sendFileToTerminal",
        "title": "ULW: Send File to Terminal",
        "category": "ULW"
      },
      {
        "command": "ulw.attachHerdrSession",
        "title": "ULW: Attach Herdr Session",
        "category": "ULW"
      },
      {
        "command": "ulw.detachHerdrSession",
        "title": "ULW: Detach Herdr Session",
        "category": "ULW"
      },
      {
        "command": "ulw.herdr.openAgent",
        "title": "ULW: Attach Herdr Agent",
        "category": "ULW"
      },
      {
        "command": "ulw.herdr.openSpace",
        "title": "ULW: Reveal Herdr Space",
        "category": "ULW"
      },
      {
        "command": "ulw.herdr.refreshExplorer",
        "title": "ULW: Refresh Herdr Explorer",
        "category": "ULW",
        "icon": "$(refresh)"
      },
      {
        "command": "ulw.herdr.showMenu",
        "title": "ULW: Manage Herdr Agents",
        "category": "ULW",
        "enablement": "config.ulw.herdr.enabled"
      },
      {
        "command": "ulw.herdr.openDag",
        "title": "ULW: Open Herdr DAG",
        "category": "ULW",
        "enablement": "config.ulw.herdr.enabled"
      }
    ],
    "menus": {
      "commandPalette": [
        { "command": "ulw.herdr.showMenu", "when": "config.ulw.herdr.enabled" },
        { "command": "ulw.herdr.openDag", "when": "config.ulw.herdr.enabled" }
      ],
      "editor/context": [
        {
          "command": "ulw.sendSelectionToTerminal",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "ulw.sendFileToTerminal",
          "group": "2_workspace"
        }
      ],
      "view/title": [
        {
          "command": "ulw.toggleEditorLocation",
          "when": "view == ulw && !config.ulw.herdr.enabled",
          "group": "navigation"
        },
        {
          "command": "ulw.herdr.refreshExplorer",
          "when": "view == ulw.herdr.spaces || view == ulw.herdr.agents",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "ulw.toggleEditorLocation",
          "when": "activeWebviewPanelId == 'ulw.terminalEditor'",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "ULW Terminal",
      "properties": {
        "ulw.sidebar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the ULW label in the secondary sidebar. Turn this off to hide ULW from the sidebar completely; the terminal still opens as an editor tab."
        },
        "ulw.defaultLocation": {
          "type": "string",
          "enum": [
            "sidebar",
            "editor"
          ],
          "enumDescriptions": [
            "Open the terminal in the secondary sidebar.",
            "Open the terminal in an editor-group tab."
          ],
          "default": "editor",
          "description": "Where ULW opens the terminal by default. Use ULW: Toggle Terminal Location to switch at any time."
        },
        "ulw.fontSize": {
          "type": "number",
          "default": 14,
          "minimum": 8,
          "maximum": 72,
          "description": "Terminal font size."
        },
        "ulw.fontFamily": {
          "type": "string",
          "default": "'JetBrainsMono Nerd Font', 'FiraCode Nerd Font', Menlo, Monaco, 'Apple SD Gothic Neo', 'Malgun Gothic', 'PingFang SC', 'Microsoft YaHei', 'Hiragino Sans', 'Noto Sans CJK KR', 'Noto Sans CJK JP', 'Noto Sans CJK SC', monospace",
          "description": "Terminal font family. Include CJK fallbacks so Hangul/Kanji/Hanzi render under WebGL and during IME composition."
        },
        "ulw.cursorBlink": {
          "type": "boolean",
          "default": true,
          "description": "Whether the terminal cursor blinks."
        },
        "ulw.renderer": {
          "type": "string",
          "enum": [
            "webgl",
            "dom"
          ],
          "enumDescriptions": [
            "Use the faster WebGL renderer (default). Switch off if you see rendering artifacts or ghosting.",
            "Use the DOM renderer. A workaround for GPUs/drivers that glitch under WebGL."
          ],
          "default": "webgl",
          "description": "Terminal renderer. Pick 'dom' to work around WebGL rendering artifacts such as traces of previous frames. Requires reopening the terminal view to apply."
        },
        "ulw.cursorStyle": {
          "type": "string",
          "enum": [
            "block",
            "underline",
            "bar"
          ],
          "default": "block",
          "description": "Terminal cursor style."
        },
        "ulw.scrollback": {
          "type": "number",
          "default": 10000,
          "minimum": 0,
          "maximum": 100000,
          "description": "Number of terminal scrollback lines."
        },
        "ulw.shellPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Optional shell executable. Empty uses the VS Code or system default shell."
        },
        "ulw.shellArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine-overridable",
          "description": "Arguments passed to the shell executable."
        },
        "ulw.herdr.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable Herdr Spaces/Agents and attach/detach. Off by default; ULW is only a terminal until this is turned on."
        },
        "ulw.herdr.executablePath": {
          "type": "string",
          "default": "herdr",
          "scope": "machine-overridable",
          "description": "Herdr executable path. GUI-launched VS Code may not inherit your shell PATH, so configure an absolute path when herdr cannot be found."
        },
        "ulw.herdr.socketPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Optional Herdr socket path. Ignored when a named Herdr session is configured."
        },
        "ulw.herdr.session": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Optional named Herdr session. When set, it takes precedence over the socket path."
        },
        "ulw.herdr.remoteTarget": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "SSH target (e.g. user@host) whose Herdr server ULW should reach while VS Code is connected to a remote window. ULW forwards the remote API and client sockets over SSH and routes Spaces/Agents listing and attach through them. Targets the default Herdr session; a configured ulw.herdr.session is ignored while forwarding. Ignored in local windows."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && webpack",
    "compile:e2e": "tsc -p tsconfig.e2e.json",
    "watch": "webpack --watch",
    "package": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && webpack --mode production --devtool hidden-source-map",
    "lint": "eslint src --ext ts",
    "format": "prettier --write \"src/**/*.{ts,js,json,css,md}\"",
    "test": "vitest run",
    "pretest:e2e": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\" && npm run compile && npm run compile:e2e",
    "test:e2e": "vscode-test",
    "test:e2e:herdr": "npm run pretest:e2e && vscode-test --label herdr",
    "test:all": "npm run test && npm run test:e2e",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "package:vsix": "npm run package && npx @vscode/vsce package --allow-star-activation && node script/qa/check-vsix-node-pty.mjs",
    "build-and-install": "npx @vscode/vsce package -o build/extension.vsix && code --install-extension build/extension.vsix --force"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.13",
    "@types/vscode": "^1.106.1",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "@vitest/coverage-v8": "^4.1.8",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "css-loader": "^7.1.2",
    "eslint": "^8.56.0",
    "jsdom": "^29.1.1",
    "mocha": "^11.7.5",
    "prettier": "^3.7.2",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8",
    "webpack": "^5.105.2",
    "webpack-cli": "^6.0.0"
  },
  "dependencies": {
    "node-pty": "^1.2.0-beta.11"
  },
  "activationEvents": [
    "onView:ulw",
    "onView:ulw.herdr.spaces",
    "onView:ulw.herdr.agents",
    "onCommand:ulw.toggleEditorLocation",
    "onCommand:ulw.sendSelectionToTerminal",
    "onCommand:ulw.sendFileToTerminal",
    "onCommand:ulw.attachHerdrSession",
    "onCommand:ulw.detachHerdrSession",
    "onCommand:ulw.herdr.openAgent",
    "onCommand:ulw.herdr.openSpace",
    "onCommand:ulw.herdr.refreshExplorer",
    "onStartupFinished"
  ],
  "allowScripts": {
    "node-pty@1.2.0-beta.11": true
  }
}
